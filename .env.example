# Supabase -> tombol Connect -> Transaction pooler (port 6543). Ganti [PASSWORD] (URL-encode jika ada simbol).
DATABASE_URL=postgresql://postgres.xxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Rahasia aplikasi (buat dengan: openssl rand -hex 32)
AUTH_SECRET=
# Kunci sekali pakai untuk membuat admin pertama
SETUP_KEY=
